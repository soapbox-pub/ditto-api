PORT="3000"

# Public URL of the Ditto frontend. Used in the favicon fetcher's User-Agent
# and as the base of the default API_URL.
PUBLIC_URL="https://ditto.pub"

# Base URL of this API, path prefix included. Image proxy URLs baked into
# link previews are built from it. Defaults to "${PUBLIC_URL}/api".
API_URL="https://api.ditto.pub"

# Nostr relays queried for OG image data (comma-separated)
RELAY_URLS="wss://relay.ditto.pub"

# Relay query timeout in milliseconds
# QUERY_TIMEOUT="5000"

# SQLite cache database
# DB_PATH="data/ditto-api.sqlite"

# User-Agent for link preview and preview image fetches
# LINK_PREVIEW_USER_AGENT="facebookexternalhit"

# Link preview cache TTL in milliseconds (24 hours)
# LINK_PREVIEW_CACHE_TTL="86400000"

# Link preview cache TTL for failures, in milliseconds (10 minutes)
# LINK_PREVIEW_ERROR_TTL="600000"

# Maximum concurrent outbound link preview fetches
# LINK_PREVIEW_CONCURRENCY="8"

# Maximum link preview fetches queued before requests are shed with a 503
# LINK_PREVIEW_QUEUE_LIMIT="64"

# OG image cache TTL in milliseconds (1 hour)
# OG_IMAGE_CACHE_TTL="3600000"

# Upstream fetch limits
# FETCH_TIMEOUT="3000"
# MAX_HTML_BYTES="2097152"
# MAX_IMAGE_BYTES="2097152"
# MAX_JSON_BYTES="262144"

# Log filter (tracing-subscriber EnvFilter syntax)
# RUST_LOG="info"
